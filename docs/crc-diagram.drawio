<mxfile host="app.diagrams.net"><diagram id="crc-final" name="CRC by MVC layer (Final Project)"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2048" pageHeight="3570" background="#EDE4D3" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Dreamimin: CRC cards by MVC layer (Final Project)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=28;fontStyle=1;fontColor=#2E261D;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="50" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;Each card is one class or module: what it &lt;b&gt;does&lt;/b&gt; (responsibilities), what it &lt;b&gt;knows&lt;/b&gt;, and who it &lt;b&gt;works with&lt;/b&gt; (collaborators).&lt;br&gt;Dark header, solid border = built (merged, or in an open branch on 11/15). Lighter header, dashed border = planned, with its owner.&lt;br&gt;&lt;br&gt;&lt;b&gt;How the layers map to MVC&lt;/b&gt; (confirmed by Prof. Kandel, 11/9)&lt;br&gt;View = browser views. Controller = browser controllers and Express API routes. Model = services, repositories, domain classes and the planners in the Web Worker. SQLite is what the Model connects to.&lt;br&gt;&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;Views and controllers are in separate files. Routes, services and repositories each have their own file. Views never call the API. Controllers and routes hold no business rules and no SQL. On the server each layer only calls the one below it: routes → services → repositories → SQLite." style="rounded=0;fillColor=#FBF8F0;strokeColor=#2E261D;spacing=14;verticalAlign=top;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=13;fontStyle=0;fontColor=#2E261D;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1968" height="190" as="geometry"/></mxCell><mxCell id="view" value="" style="rounded=1;arcSize=2;html=1;fillColor=#DCE5D2;strokeColor=#2E261D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1968" height="361" as="geometry"/></mxCell><mxCell id="view-title" value="VIEW · in the browser · client/views/" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=22;fontStyle=1;fontColor=#2E261D;" vertex="1" parent="1"><mxGeometry x="64" y="340" width="1920" height="40" as="geometry"/></mxCell><mxCell id="view-0-0" value="MoneyView" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="64" y="386" width="300" height="277" as="geometry"/></mxCell><mxCell id="view-0-0-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/views/moneyView.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Shows step 1: monthly cash flow, savings rate and the list of recorded spending&lt;/div&gt;&lt;div&gt;• Shows how recorded spending changed the chance&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Only what it is given&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; MoneyController (tells it what to show); reads FinancialProfile, AvailableFunds&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="view-0-0"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="view-0-1" value="GoalView" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="388" y="386" width="300" height="277" as="geometry"/></mxCell><mxCell id="view-0-1-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/views/goalView.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Shows step 2: the goal list, the add/edit form and the goal check&lt;/div&gt;&lt;div&gt;• Marks each row with its goal id and action for the controller&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Only what it is given&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; GoalController&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="view-0-1"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="view-0-2" value="OddsView" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="712" y="386" width="300" height="277" as="geometry"/></mxCell><mxCell id="view-0-2-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/views/oddsView.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Shows step 3: training progress, the chance, verdict, outcomes and the portfolio for each year&lt;/div&gt;&lt;div&gt;• Lists the five portfolios&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Only what it is given&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; OddsController; reads GoalAnalysisResult, InvestmentPortfolio&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="view-0-2"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="view-0-3" value="StepsView" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1036" y="386" width="300" height="277" as="geometry"/></mxCell><mxCell id="view-0-3-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/views/steps.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Shows one step at a time and keeps the step bar and the address in step&lt;/div&gt;&lt;div&gt;• Animates the chance ring&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Which step is open&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Listens for the plan:* events the controllers send&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="view-0-3"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="view-0-4" value="FieldView" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1360" y="386" width="300" height="277" as="geometry"/></mxCell><mxCell id="view-0-4-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/views/fieldView.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Shows an error message under a form field&lt;/div&gt;&lt;div&gt;• Shows a confirm dialog and answers with a promise&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Nothing&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Every controller&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="view-0-4"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="view-0-5" value="PlanView (planned: Aiyan)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1684" y="386" width="300" height="277" as="geometry"/></mxCell><mxCell id="view-0-5-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/views/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Shows the multi-goal dashboard: goal cards with chance and verdict, the goal timeline, the spending pie chart&lt;/div&gt;&lt;div&gt;• Shows the what-if slider and the five risk levels side by side&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Only what it is given&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; PlanController; reads MultiGoalPlan&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="view-0-5"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="controller" value="" style="rounded=1;arcSize=2;html=1;fillColor=#E9DCC0;strokeColor=#2E261D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="761" width="1968" height="751" as="geometry"/></mxCell><mxCell id="controller-title" value="CONTROLLER · browser controllers and Express API routes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=22;fontStyle=1;fontColor=#2E261D;" vertex="1" parent="1"><mxGeometry x="64" y="771" width="1920" height="40" as="geometry"/></mxCell><mxCell id="controller-sub0" value="Browser controllers · client/controllers/ · and the API client they call · client/api/" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=14;fontStyle=1;fontColor=#4A4034;" vertex="1" parent="1"><mxGeometry x="64" y="817" width="1920" height="26" as="geometry"/></mxCell><mxCell id="controller-0-0" value="MoneyController" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="64" y="851" width="300" height="311" as="geometry"/></mxCell><mxCell id="controller-0-0-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/controllers/moneyController.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Reads the income, spending, net worth and funds fields&lt;/div&gt;&lt;div&gt;• Builds the FinancialProfile and keeps the AvailableFunds&lt;/div&gt;&lt;div&gt;• Records and removes spending, then tells MoneyView what to show&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The current profile and funds&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; FinancialProfile, AvailableFunds, Expense, MoneyView, FieldView&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="controller-0-0"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="controller-0-1" value="GoalController" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="388" y="851" width="300" height="311" as="geometry"/></mxCell><mxCell id="controller-0-1-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/controllers/goalController.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Loads the goals through GoalApi&lt;/div&gt;&lt;div&gt;• Handles add, edit, delete (after a confirm), sort, search and choosing a goal&lt;/div&gt;&lt;div&gt;• Tells GoalView what to show&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The goals on screen and the chosen goal&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; GoalApi, FinancialGoal, GoalList, GoalView, FieldView&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="controller-0-1"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="controller-0-2" value="OddsController" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="712" y="851" width="300" height="311" as="geometry"/></mxCell><mxCell id="controller-0-2-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/controllers/oddsController.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Runs PpoPlanner for the chosen goal in PlannerWorker, or on the page when workers are blocked&lt;/div&gt;&lt;div&gt;• Keeps finished results so the same job isn&amp;#x27;t trained twice&lt;/div&gt;&lt;div&gt;• Tells OddsView and StepsView what to show&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Finished results per job&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; PlannerWorker, PpoPlanner, GoalAnalysisResult, OddsView&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="controller-0-2"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="controller-0-3" value="PlanController (planned: Aiyan, Jess)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1036" y="851" width="300" height="311" as="geometry"/></mxCell><mxCell id="controller-0-3-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/controllers/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Sends every goal to MultiGoalPlanner through PlannerWorker&lt;/div&gt;&lt;div&gt;• Previews a risk level before the user confirms it&lt;/div&gt;&lt;div&gt;• Asks for a what-if estimate as the slider moves&lt;/div&gt;&lt;div&gt;• Saves the finished plan&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The latest plan and the risk level being previewed&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; PlannerWorker, MultiGoalPlan, the API client, PlanView&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="controller-0-3"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="controller-0-4" value="GoalApi (API client)" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1360" y="851" width="300" height="311" as="geometry"/></mxCell><mxCell id="controller-0-4-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;client/api/goalApi.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• The only browser code that talks to the server: list, get, create, update and remove goals&lt;/div&gt;&lt;div&gt;• MemoryGoalApi follows the same contract in memory until the server saves goals&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The server&amp;#x27;s address and the API&amp;#x27;s shapes&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Called by GoalController; sends HTTP to GoalRoutes; GoalList, FinancialGoal&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="controller-0-4"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="controller-sub1" value="Express API routes · server/routes/ · reached over HTTP (JSON)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=14;fontStyle=1;fontColor=#4A4034;" vertex="1" parent="1"><mxGeometry x="64" y="1190" width="1920" height="26" as="geometry"/></mxCell><mxCell id="controller-1-0" value="GoalRoutes" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="64" y="1224" width="300" height="260" as="geometry"/></mxCell><mxCell id="controller-1-0-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/routes/goalRoutes.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Turns /api/goals requests into GoalService calls&lt;/div&gt;&lt;div&gt;• Turns the results into JSON and status codes&lt;/div&gt;&lt;div&gt;• No SQL and no business rules (GET is built; POST, PUT, DELETE: Autiana)&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The paths and status codes&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; GoalService&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="controller-1-0"><mxGeometry y="40" width="300" height="220" as="geometry"/></mxCell><mxCell id="controller-1-1" value="ProfileRoutes (planned: Autiana)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="388" y="1224" width="300" height="260" as="geometry"/></mxCell><mxCell id="controller-1-1-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/routes/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Handles /api/profile and /api/risk-preference&lt;/div&gt;&lt;div&gt;• No SQL and no business rules&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The paths and status codes&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; ProfileService&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="controller-1-1"><mxGeometry y="40" width="300" height="220" as="geometry"/></mxCell><mxCell id="controller-1-2" value="FundsRoutes (planned: Autiana)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="712" y="1224" width="300" height="260" as="geometry"/></mxCell><mxCell id="controller-1-2-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/routes/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Handles /api/funds, /api/expenses and /api/funds-events&lt;/div&gt;&lt;div&gt;• No SQL and no business rules&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The paths and status codes&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; FundsService&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="controller-1-2"><mxGeometry y="40" width="300" height="220" as="geometry"/></mxCell><mxCell id="controller-1-3" value="PlanRoutes (planned: Aiyan)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1036" y="1224" width="300" height="260" as="geometry"/></mxCell><mxCell id="controller-1-3-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/routes/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Handles /api/plans, /api/plans/latest and /api/portfolios&lt;/div&gt;&lt;div&gt;• No SQL and no business rules&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The paths and status codes&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; PlanService&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="controller-1-3"><mxGeometry y="40" width="300" height="220" as="geometry"/></mxCell><mxCell id="model" value="" style="rounded=1;arcSize=2;html=1;fillColor=#E3D5CF;strokeColor=#2E261D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1582" width="1968" height="1768" as="geometry"/></mxCell><mxCell id="model-title" value="MODEL · services, repositories, domain classes and the planners" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=22;fontStyle=1;fontColor=#2E261D;" vertex="1" parent="1"><mxGeometry x="64" y="1592" width="1920" height="40" as="geometry"/></mxCell><mxCell id="model-sub0" value="Services · server/services/ · the business rules on the server" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=14;fontStyle=1;fontColor=#4A4034;" vertex="1" parent="1"><mxGeometry x="64" y="1638" width="1920" height="26" as="geometry"/></mxCell><mxCell id="model-0-0" value="GoalService" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="64" y="1672" width="300" height="277" as="geometry"/></mxCell><mxCell id="model-0-0-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/services/goalService.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Checks a goal with FinancialGoal before it is saved&lt;/div&gt;&lt;div&gt;• Enforces the 20-goal limit; sorts and searches with GoalList&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The profile it works for&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; GoalRepository, FinancialGoal, GoalList&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-0-0"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="model-0-1" value="ProfileService (planned: Autiana)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="388" y="1672" width="300" height="277" as="geometry"/></mxCell><mxCell id="model-0-1-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/services/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Checks income, spending and net worth with FinancialProfile&lt;/div&gt;&lt;div&gt;• Checks the risk level (1 to 5)&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The profile it works for&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; ProfileRepository, FinancialProfile, RiskPreference&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-0-1"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="model-0-2" value="FundsService (planned: Autiana)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="712" y="1672" width="300" height="277" as="geometry"/></mxCell><mxCell id="model-0-2-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/services/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Sets the funds; records, edits and removes spending, income and losses&lt;/div&gt;&lt;div&gt;• Never lets the funds go below $0&lt;/div&gt;&lt;div&gt;• Filters spending by category, dates and search&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The profile it works for&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; FundsRepository, AvailableFunds, Expense, FundsEvent&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-0-2"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="model-0-3" value="PlanService (planned: Aiyan)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1036" y="1672" width="300" height="277" as="geometry"/></mxCell><mxCell id="model-0-3-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/services/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Checks a plan with MultiGoalPlan and adds each goal&amp;#x27;s verdict&lt;/div&gt;&lt;div&gt;• Saves the plan and returns the latest one&lt;/div&gt;&lt;div&gt;• Lists the five portfolios&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The profile it works for&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; PlanRepository, MultiGoalPlan, GoalProbability, InvestmentPortfolio&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-0-3"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="model-sub1" value="Repositories · server/repositories/ · the only code that runs SQL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=14;fontStyle=1;fontColor=#4A4034;" vertex="1" parent="1"><mxGeometry x="64" y="1977" width="1920" height="26" as="geometry"/></mxCell><mxCell id="model-1-0" value="GoalRepository" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="64" y="2011" width="300" height="226" as="geometry"/></mxCell><mxCell id="model-1-0-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/repositories/goalRepository.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Runs the SQL for the goal table&lt;/div&gt;&lt;div&gt;• Hands the service plain objects with the API&amp;#x27;s field names&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The goal table&amp;#x27;s columns&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; SQLite: goal&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-1-0"><mxGeometry y="40" width="300" height="186" as="geometry"/></mxCell><mxCell id="model-1-1" value="ProfileRepository (planned: Autiana)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="388" y="2011" width="300" height="226" as="geometry"/></mxCell><mxCell id="model-1-1-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/repositories/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Runs the SQL for the profile and its risk preference&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Those tables&amp;#x27; columns&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; SQLite: profile, risk_preference&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-1-1"><mxGeometry y="40" width="300" height="186" as="geometry"/></mxCell><mxCell id="model-1-2" value="FundsRepository (planned: Autiana)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="712" y="2011" width="300" height="226" as="geometry"/></mxCell><mxCell id="model-1-2-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/repositories/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Runs the SQL for the funds, the spending and the income and loss events&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Those tables&amp;#x27; columns&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; SQLite: available_funds, expense, funds_event&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-1-2"><mxGeometry y="40" width="300" height="186" as="geometry"/></mxCell><mxCell id="model-1-3" value="PlanRepository (planned: Aiyan)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1036" y="2011" width="300" height="226" as="geometry"/></mxCell><mxCell id="model-1-3-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;server/repositories/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Runs the SQL for saved plans, each goal&amp;#x27;s result and each year&amp;#x27;s portfolio&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Those tables&amp;#x27; columns&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; SQLite: plan_result, goal_result, plan_year, investment_portfolio&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-1-3"><mxGeometry y="40" width="300" height="186" as="geometry"/></mxCell><mxCell id="model-sub2" value="Domain classes · src/ · shared by the page and the server" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=14;fontStyle=1;fontColor=#4A4034;" vertex="1" parent="1"><mxGeometry x="64" y="2265" width="1920" height="26" as="geometry"/></mxCell><mxCell id="model-2-0" value="FinancialProfile" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="64" y="2299" width="300" height="277" as="geometry"/></mxCell><mxCell id="model-2-0-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/financialProfile.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Works out the monthly cash flow and the savings rate&lt;/div&gt;&lt;div&gt;• Checks and updates income, spending and net worth&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; id, name, income, expenses, netWorth&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Used by MoneyController and ProfileService&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-2-0"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="model-2-1" value="FinancialGoal" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="388" y="2299" width="300" height="277" as="geometry"/></mxCell><mxCell id="model-2-1-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/financialGoal.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Checks a goal&amp;#x27;s fields&lt;/div&gt;&lt;div&gt;• Works out months remaining, the monthly saving required, whether a saving is on track and how long it takes&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; id, name, targetAmount, targetDate, priority (1 to 5), minAcceptableAmount&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Used by GoalController, GoalApi and GoalService&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-2-1"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="model-2-2" value="GoalList" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="712" y="2299" width="300" height="277" as="geometry"/></mxCell><mxCell id="model-2-2-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/goalList.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Holds the rules for the list of goals: at most 20&lt;/div&gt;&lt;div&gt;• Sorts by date, priority, amount or name, and searches by name&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; The limit and the sort orders&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Used by GoalController, GoalApi and GoalService&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-2-2"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="model-2-3" value="AvailableFunds" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1036" y="2299" width="300" height="277" as="geometry"/></mxCell><mxCell id="model-2-3-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/availableFunds.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Holds the funds left now&lt;/div&gt;&lt;div&gt;• Records and removes spending and keeps the balance right&lt;/div&gt;&lt;div&gt;• Adds up the total spent&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; id, balance, expenses, totalSpent&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Expense; used by MoneyController and FundsService&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-2-3"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="model-2-4" value="Expense" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1360" y="2299" width="300" height="277" as="geometry"/></mxCell><mxCell id="model-2-4-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/expense.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• One recorded spending&lt;/div&gt;&lt;div&gt;• Checks its amount, date, note and category&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; id, amount, date, note, category&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Recorded against AvailableFunds&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-2-4"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="model-2-5" value="FundsEvent (planned: Autiana)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1684" y="2299" width="300" height="277" as="geometry"/></mxCell><mxCell id="model-2-5-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• One income or loss outside everyday spending&lt;/div&gt;&lt;div&gt;• Checks its kind, amount, date and note&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; id, kind (income or loss), amount, date, note&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Raises or lowers AvailableFunds&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-2-5"><mxGeometry y="40" width="300" height="237" as="geometry"/></mxCell><mxCell id="model-3-0" value="InvestmentPortfolio" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="64" y="2604" width="300" height="311" as="geometry"/></mxCell><mxCell id="model-3-0-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/investmentPortfolio.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• One of the five portfolios, lowest risk first&lt;/div&gt;&lt;div&gt;• Gives its typical range for a year and describes itself&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; riskLevel (1 to 5), name, expectedReturn, volatility&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Same numbers as the planners; used by OddsView and PlanService&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-3-0"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="model-3-1" value="RiskPreference (planned: Autiana)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="388" y="2604" width="300" height="311" as="geometry"/></mxCell><mxCell id="model-3-1-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Holds the highest risk level the plan may use&lt;/div&gt;&lt;div&gt;• Checks that it is from 1 to 5&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; maxRiskLevel&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Read by PlanController for the planner&amp;#x27;s job&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-3-1"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="model-3-2" value="GoalProbability" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="712" y="2604" width="300" height="311" as="geometry"/></mxCell><mxCell id="model-3-2-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/goalProbability.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• A chance from 0 to 1&lt;/div&gt;&lt;div&gt;• Gives its verdict (Realistic to Not realistic yet), tone and percent&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; value&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Used by GoalAnalysisResult and MultiGoalPlan&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-3-2"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="model-3-3" value="GoalAnalysisResult" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1036" y="2604" width="300" height="311" as="geometry"/></mxCell><mxCell id="model-3-3-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/goalAnalysisResult.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Holds what PpoPlanner worked out for one goal&lt;/div&gt;&lt;div&gt;• Rejects a result that doesn&amp;#x27;t make sense&lt;/div&gt;&lt;div&gt;• Describes the portfolio for each year in words&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; probability, benchmark, efficiency, outcomes (10th, 50th, 90th), glide&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; GoalProbability; built from PpoPlanner&amp;#x27;s result&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-3-3"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="model-3-4" value="MultiGoalPlan" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1360" y="2604" width="300" height="311" as="geometry"/></mxCell><mxCell id="model-3-4-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/multiGoalPlan.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Holds one plan for all the goals at one risk level&lt;/div&gt;&lt;div&gt;• Gives each goal its chance in full, in part and of either, with its verdict&lt;/div&gt;&lt;div&gt;• Gives the body POST /api/plans takes&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; maxRiskLevel, utility, dpUtility, rlEfficiency, riskLevelByYear, goals&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; GoalProbability; built from MultiGoalPlanner&amp;#x27;s result&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-3-4"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="model-3-5" value="RetirementPlan (planned: owner TBD)" style="swimlane;html=1;startSize=40;fillColor=#8C8A6E;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1684" y="2604" width="300" height="311" as="geometry"/></mxCell><mxCell id="model-3-5-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/ (new)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• After the retirement age, withdraws a yearly amount&lt;/div&gt;&lt;div&gt;• Works out the chance the money lasts to a chosen age&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; retirementAge, yearlyWithdrawal, lastsToAge&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; The planners&amp;#x27; wealth model; GoalProbability&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-3-5"><mxGeometry y="40" width="300" height="271" as="geometry"/></mxCell><mxCell id="model-sub4" value="Planners · src/ · run in a Web Worker in the browser" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=14;fontStyle=1;fontColor=#4A4034;" vertex="1" parent="1"><mxGeometry x="64" y="2943" width="1920" height="26" as="geometry"/></mxCell><mxCell id="model-4-0" value="PpoPlanner" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="64" y="2977" width="300" height="345" as="geometry"/></mxCell><mxCell id="model-4-0-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/ppoPlanner.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Trains a PPO policy on the wealth model for one goal&lt;/div&gt;&lt;div&gt;• Solves the same problem with dynamic programming as the benchmark&lt;/div&gt;&lt;div&gt;• Works out RL efficiency&lt;/div&gt;&lt;div&gt;• Holds the network and PPO update MultiGoalPlanner shares&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; PORTFOLIOS, MAX_YEARS (40), EVAL_PATHS (4,000), the seeds&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; Its result becomes a GoalAnalysisResult&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-4-0"><mxGeometry y="40" width="300" height="305" as="geometry"/></mxCell><mxCell id="model-4-1" value="MultiGoalPlanner" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="388" y="2977" width="300" height="345" as="geometry"/></mxCell><mxCell id="model-4-1-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/multiGoalPlanner.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Plans every goal from one pot: take in full, take in part or skip, and which portfolio to hold within the risk level&lt;/div&gt;&lt;div&gt;• Trains PPO and solves the DP benchmark; reports each goal&amp;#x27;s chance&lt;/div&gt;&lt;div&gt;• Answers quickly from the benchmark: estimate, the five risk levels, what-if changes&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; MAX_GOALS (20), the training budget, the timeline of stops&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; PpoPlanner (network, PPO update, market paths); its result becomes a MultiGoalPlan&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-4-1"><mxGeometry y="40" width="300" height="305" as="geometry"/></mxCell><mxCell id="model-4-2" value="PlannerWorker" style="swimlane;html=1;startSize=40;fillColor=#33432F;fontColor=#F4EEE2;strokeColor=#2E261D;swimlaneFillColor=#FBF8F0;fontFamily=Georgia;fontSize=15;fontStyle=1;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="712" y="2977" width="300" height="345" as="geometry"/></mxCell><mxCell id="model-4-2-body" value="&lt;div style=&quot;color:#6B6255&quot;&gt;&lt;i&gt;src/planner.worker.js&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;does:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;• Runs the planners off the page so training doesn&amp;#x27;t freeze it&lt;/div&gt;&lt;div&gt;• Posts the benchmark, each round&amp;#x27;s progress and the result&lt;/div&gt;&lt;div&gt;• Answers compare and what-if tasks&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;knows:&lt;/b&gt; Which planner a job needs&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;b&gt;works with:&lt;/b&gt; PpoPlanner, MultiGoalPlanner; started by OddsController and PlanController&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Georgia;fontSize=12;fontColor=#2E261D;" vertex="1" parent="model-4-2"><mxGeometry y="40" width="300" height="305" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;SQLite database&lt;/b&gt; · server/schema.sql, opened by server/db.js with node:sqlite · data/dreamimin.db&lt;br&gt;Tables: profile, risk_preference, goal, available_funds, expense, funds_event, investment_portfolio, plan_result, goal_result, plan_year (the ER diagram, docs/er-diagram.drawio).&lt;br&gt;Every table checks the same limits as the API, so a bad value can&#x27;t be saved even by a bug in a route. Data stays between visits." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#D5D9E0;strokeColor=#2E261D;strokeWidth=1.5;fontFamily=Georgia;fontSize=14;fontColor=#2E261D;" vertex="1" parent="1"><mxGeometry x="40" y="3420" width="1968" height="110" as="geometry"/></mxCell><mxCell id="a-input" value="user input (clicks, typing)" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=10;strokeColor=#7A2E2E;strokeWidth=2;fontFamily=Georgia;fontSize=13;fontStyle=2;fontColor=#2E261D;labelBackgroundColor=#EDE4D3;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="view" target="controller"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a-show" value="what to show" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=10;strokeColor=#7A2E2E;strokeWidth=2;fontFamily=Georgia;fontSize=13;fontStyle=2;fontColor=#2E261D;labelBackgroundColor=#EDE4D3;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="controller" target="view"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a-calls" value="calls: domain classes, planners, services" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=10;strokeColor=#7A2E2E;strokeWidth=2;fontFamily=Georgia;fontSize=13;fontStyle=2;fontColor=#2E261D;labelBackgroundColor=#EDE4D3;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="controller" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a-results" value="results and errors" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=10;strokeColor=#7A2E2E;strokeWidth=2;fontFamily=Georgia;fontSize=13;fontStyle=2;fontColor=#2E261D;labelBackgroundColor=#EDE4D3;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="model" target="controller"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a-sql" value="SQL (repositories only)" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=10;strokeColor=#7A2E2E;strokeWidth=2;fontFamily=Georgia;fontSize=13;fontStyle=2;fontColor=#2E261D;labelBackgroundColor=#EDE4D3;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="model" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a-rows" value="rows" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=10;strokeColor=#7A2E2E;strokeWidth=2;fontFamily=Georgia;fontSize=13;fontStyle=2;fontColor=#2E261D;labelBackgroundColor=#EDE4D3;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="db" target="model"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
